# Frontend (copy into frontend/.env)
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend (copy into backend/.env)
ENVIRONMENT=development
# JSON array or comma-separated. Production: your Vercel URL.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-settings
SUPABASE_ANON_KEY=your-anon-key
# Server-only — never expose to the frontend or commit
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — LLM extract + Scan sources (Phase 1)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5-nano
# EXTRACT_USE_LLM=true
